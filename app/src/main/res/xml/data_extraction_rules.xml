<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            Exclude EncryptedSharedPreferences from Google Drive backup.
            The Keystore key is device-specific; restoring the ciphertext to a
            different device produces an unreadable file and a KeyStoreException.
        -->
        <exclude domain="sharedpref" path="secure_agent_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!--
            Exclude from device-to-device transfer for the same reason.
            The user will be prompted to re-enter their Agent Token on the new device.
        -->
        <exclude domain="sharedpref" path="secure_agent_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
