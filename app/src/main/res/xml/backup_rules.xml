<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy backup rules (used on devices running Android 11 and below).
    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
        Exclude the EncryptedSharedPreferences file from cloud backup.
        The Keystore encryption key is device-specific; a backup of the
        encrypted file is useless on another device and would cause
        EncryptedSharedPreferences initialization to fail with a
        KeyStoreException after restore.
    -->
    <exclude domain="sharedpref" path="secure_agent_prefs.xml" />
</full-backup-content>
