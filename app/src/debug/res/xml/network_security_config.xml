<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug build override. Redundant now that the main config allows cleartext
    for demo delivery, but kept as an explicit marker for debug intent.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
